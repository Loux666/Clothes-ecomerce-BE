PORT=3000

# Cấu hình kết nối DB cho NodeJS
DB_HOST=localhost
DB_PORT=3307
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Cấu hình Prisma ORM
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3307/your_db_name"

# Cấu hình gửi mail (Ví dụ dùng Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mail_username
MAIL_PASS=your_mail_password
